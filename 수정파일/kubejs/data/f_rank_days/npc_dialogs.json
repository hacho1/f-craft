    "hess": {
      "npc_id": "hess",
      "name": "헤스",
      "job_grade_badge": "통합 길드 접수원",
      "affiliation": "아르베른 통합 길드 브리온 지부 (북쪽 지구)",
      "subtitle": "정중하고 빈틈없는 브리온 지부 행정 책임 접수원",
